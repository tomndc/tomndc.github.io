---
import { iconUrlFor } from "../lib/icons";

interface Props {
  item: {
    name: string;
    type?: string;
    description: string;
    technologies: string[] | string;
  };
  href?: string;
}

const { item, href } = Astro.props;
const Tag = href ? "a" : "button";

const techs: string[] = Array.isArray(item.technologies)
  ? item.technologies
  : item.technologies.split(",").map((t) => t.trim());
---

<Tag
  class="fi-row"
  href={href}
  data-project-btn={href ? undefined : true}
  data-project-id={item.name}
>
  <div class="fi-thumb">
    {
      (item as any).thumbnail ? (
        <img src={(item as any).thumbnail} alt="" class="fi-thumb-img" />
      ) : (
        <span class="fi-thumb-letter">
          {item.name.charAt(0).toUpperCase()}
        </span>
      )
    }
  </div>

  <div class="fi-text">
    <span class="fi-name">{item.name}</span>
    <div class="fi-bottom-row">
      <span class="fi-desc">{item.description}</span>
      <div class="fi-icons" aria-label="Technologies">
        {
          techs
            .slice(0, 4)
            .map((tech) => {
              const url = iconUrlFor(tech);
              return url ? (
                <span
                  class="icon-mask fi-icon"
                  title={tech}
                  style={`-webkit-mask-image:url(${url});mask-image:url(${url});`}
                />
              ) : (
                <span class="fi-fallback" title={tech}>
                  {tech.charAt(0)}
                </span>
              );
            })
        }
        {
          techs.length > 4 && (
            <span class="fi-icon-more">+{techs.length - 4}</span>
          )
        }
      </div>
    </div>
  </div>
</Tag>

<style>
  .fi-row {
    display: flex;
    align-items: stretch;
    gap: 0.55rem;
    padding: 0.52rem 0;
    border-bottom: 1px solid var(--border);
    background: none;
    border-left: none;
    border-right: none;
    border-top: none;
    text-align: left;
    text-decoration: none;
    color: inherit;
    font: inherit;
    width: 100%;
    cursor: pointer;
    transition: opacity 0.15s;
  }
  .fi-row:last-of-type {
    border-bottom: none;
  }
  .fi-row:hover {
    opacity: 0.6;
  }

  .fi-thumb {
    width: 34px;
    height: 34px;
    border-radius: 4px;
    border: 1px solid var(--border);
    background: var(--surface-h);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
  }
  .fi-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .fi-thumb-letter {
    font-size: 0.85rem;
    font-weight: 700;
    opacity: 0.45;
  }

  .fi-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.15rem;
    min-width: 0;
    flex: 1;
  }

  .fi-name {
    font-size: 0.9rem;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .fi-bottom-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    min-width: 0;
  }

  .fi-desc {
    font-size: 0.9rem;
    opacity: 0.55;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
    flex: 1;
  }

  .fi-icons {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
  }
  .fi-icon {
    width: 12px;
    height: 12px;
    opacity: 0.6;
  }
  .fi-icon-more {
    font-size: 0.55rem;
    font-weight: 600;
    opacity: 0.35;
    letter-spacing: -0.02em;
  }
  .fi-fallback {
    font-size: 0.55rem;
    font-weight: 700;
    opacity: 0.4;
  }
</style>
