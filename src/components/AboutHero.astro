---
interface Props {
  avatar: string;
  name: string;
  banner?: string;
}

const { avatar, name, banner = "/banner.jpg" } = Astro.props;
---

<div class="hero">
  <div class="hero-banner" aria-hidden="true">
    {banner && <img src={banner} alt="" class="hero-banner-img" />}
  </div>
  <div class="hero-avatar">
    <img src={avatar} alt={name} />
  </div>
</div>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
  }

  .hero-banner {
    position: relative;
    overflow: hidden;
    margin-left: calc(-1 * var(--main-pad, 0.75rem));
    margin-right: calc(-1 * var(--main-pad, 0.75rem));
    height: 96px;
    flex-shrink: 0;
    border-radius: 5px;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--fg) 16%, var(--bg)) 0%,
      color-mix(in srgb, var(--fg) 3%, var(--bg)) 100%
    );
    border: 1px solid var(--border);
  }

  .hero-banner-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .hero-avatar {
    width: 64px;
    height: 64px;
    margin-top: -32px;
    margin-left: 14px;
    border-radius: 9px;
    border: 3px solid var(--bg);
    background: var(--bg);
    overflow: hidden;
    flex-shrink: 0;
    position: relative;
    z-index: 2;
  }

  .hero-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
