---
import SearchBar from "../components/SearchBar.astro";
import FeaturedRow from "../components/FeaturedRow.astro";
import ProjectCard from "../components/ProjectCard.astro";
import searchData from "../lib/data/search-data.json";
import projects from "../lib/data/projects-data.json";
import stackData from "../lib/data/stack-data.json";

const { tagsThreshold } = searchData as any;

const list = projects as any[];
const featured = list.filter((p: any) => p.featured === true);

function techsOf(p: any): string[] {
  return (Array.isArray(p.technologies) ? p.technologies : p.technologies.split(",").map((t: string) => t.trim()))
    .map((t: string) => t.toLowerCase());
}

const featuredTechs = new Set(featured.flatMap(techsOf));
const featuredTypes = new Set(featured.map((p: any) => (p.type || "").toLowerCase()).filter(Boolean));

const related = list.filter((p: any) => {
  if (p.featured === true) return false;
  const shared = techsOf(p).some((t: string) => featuredTechs.has(t));
  const sameType = featuredTypes.has((p.type || "").toLowerCase());
  return shared || sameType;
});

const stackGroups = [
  ...((stackData as any).stack ?? []),
  ...((stackData as any).learning?.length
    ? [{ category: "learning", items: (stackData as any).learning }]
    : []),
];

const allTechnologies: string[] = [
  ...new Set(
    (projects as any[]).flatMap((p: any) =>
      Array.isArray(p.technologies)
        ? p.technologies
        : p.technologies.split(",").map((t: string) => t.trim()),
    ),
  ),
].sort();

const allTypes: string[] = [
  ...new Set((projects as any[]).map((p: any) => p.type).filter(Boolean)),
].sort() as string[];
---

<section class="work-section" id="section-work">
  <div class="ps-area" id="ps-area">
    <SearchBar />

    <div class="display-box" id="display-box">
      <div id="panel-featured" class="panel">
        <p class="panel-label section-label">
          <svg class="folder-ico" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M1.5 4.2c0-.66.54-1.2 1.2-1.2h3.4l1.3 1.5h6.9c.66 0 1.2.54 1.2 1.2v7.1c0 .66-.54 1.2-1.2 1.2H2.7c-.66 0-1.2-.54-1.2-1.2V4.2Z"
              stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"
            ></path>
          </svg>
          Selected projects ({featured.length})
        </p>
        <div class="fi-list">
          {featured.map((p: any) => <FeaturedRow item={p} />)}
        </div>

        {
          related.length > 0 && (
            <div id="related-block" class="related-block" hidden>
              <p class="panel-label section-label related-label">Related projects ({related.length})</p>
              <div class="fi-list">
                {related.map((p: any) => <FeaturedRow item={p} />)}
              </div>
            </div>
          )
        }

        <div class="stack-block">
          <p class="panel-label section-label related-label">Stack</p>
          <div class="stack-groups">
            {
              stackGroups.map((group: any) => (
                <div class="stack-group">
                  <span class="stack-group-label">{group.category}</span>
                  <div class="stack-chips">
                    {group.items.map((item: any) => (
                      <span class="stack-chip" title={item.name}>
                        {item.icon && (
                          <span
                            class="icon-mask stack-chip-icon"
                            style={`-webkit-mask-image:url(https://cdn.simpleicons.org/${item.icon});mask-image:url(https://cdn.simpleicons.org/${item.icon});`}
                          />
                        )}
                        <span class="stack-chip-name">{item.name}</span>
                      </span>
                    ))}
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <div id="panel-results" class="panel panel-off">
        <p class="panel-label" id="ps-meta" aria-live="polite"></p>
        <div id="ps-grid" class="grid">
          {
            (projects as any[]).map((p: any, i: number) => (
              <ProjectCard item={p} index={i} />
            ))
          }
        </div>
      </div>

      <div id="panel-detail" class="panel panel-off">
        <div id="detail-content"></div>
      </div>
    </div>
  </div>
</section>

<div id="img-lightbox" class="lightbox" hidden>
  <button class="lb-close" id="lb-close" aria-label="Close">
    <svg viewBox="0 0 14 14" fill="none"
      ><path
        d="M11 3L3 11M3 3l8 8"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"></path></svg
    >
  </button>
  <img id="lb-img" src="" alt="" />
</div>

<script
  define:vars={{
    projects,
    allTechnologies,
    allTypes: [...allTypes, "featured"],
    tagsThreshold,
  }}
>
  window.__PS_DATA__ = { projects, allTechnologies, allTypes, tagsThreshold };
</script>
<script is:inline src="/scripts/search.js" data-astro-rerun></script>
<script is:inline data-astro-rerun>
  (function () {
    function toggleRelated() {
      var panel = document.getElementById("panel-featured");
      var related = document.getElementById("related-block");
      if (!panel || !related) return;
      var list = panel.querySelector(".fi-list");
      if (!list) return;
      var used = list.offsetHeight + 28;
      var avail = panel.clientHeight;
      related.hidden = !(avail > 0 && used < avail - 40);
    }
    window.__psToggleRelated = toggleRelated;
    document.addEventListener("layout:resized", toggleRelated);
    requestAnimationFrame(function () { setTimeout(toggleRelated, 30); });
  })();
</script>

<style>
  .work-section {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    padding-top: 12px;
  }

  .ps-area {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding-bottom: 0.55rem;
  }

  .display-box {
    margin-top: 0.5rem;
    overflow: hidden;
    flex: 1;
    min-height: 0;
  }

  .panel {
    padding: 0.65rem 0.8rem;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
    box-sizing: border-box;
  }
  .panel::-webkit-scrollbar {
    width: 2px;
  }
  .panel::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 4px;
  }

  .panel-off {
    display: none !important;
  }

  .panel-label {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.65rem;
    font-family: var(--font-mono);
    opacity: 0.5;
    margin: 0 0 0.5rem;
  }
  .section-label {
    font-size: 0.9rem;
    opacity: 0.55;
    font-weight: 500;
  }
  .folder-ico {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
  }

  .related-block {
    margin-top: 1.1rem;
    padding-top: 0.9rem;
    border-top: 1px dashed var(--border);
  }
  .related-label {
    opacity: 0.4;
  }

  .stack-block {
    margin-top: 1.1rem;
    padding-top: 0.9rem;
    border-top: 1px dashed var(--border);
  }
  .stack-groups {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .stack-group {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .stack-group-label {
    font-size: 0.6rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    opacity: 0.4;
  }
  .stack-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .stack-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
    padding: 0.22rem 0.5rem;
    border-radius: 3px;
    border: 1px solid var(--border);
    background: var(--surface-h);
  }
  .stack-chip-icon {
    width: 11px;
    height: 11px;
    opacity: 0.65;
  }
  .stack-chip-name {
    font-size: 0.68rem;
    opacity: 0.6;
    white-space: nowrap;
    line-height: 1;
  }

  .fi-list {
    display: flex;
    flex-direction: column;
  }

  #panel-featured {
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }
  #panel-featured::-webkit-scrollbar {
    width: 2px;
  }
  #panel-featured::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 4px;
  }
  .grid {
    display: flex;
    flex-direction: column;
    gap: 0.38rem;
  }

  :global(.detail-topbar) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.55rem;
  }
  :global(.detail-back-btn) {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    flex-shrink: 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 3px;
    cursor: pointer;
    color: inherit;
    font: inherit;
    font-size: 0.65rem;
    opacity: 0.5;
    padding: 0.22rem 0.5rem;
    transition:
      opacity 0.15s,
      background 0.15s,
      border-color 0.15s;
  }
  :global(.detail-back-btn:hover) {
    opacity: 1;
    background: var(--surface-h);
    border-color: var(--border-h);
  }
  :global(.detail-back-btn svg) {
    flex-shrink: 0;
  }
  :global(.detail-name-row) {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
    flex: 1;
  }
  :global(.detail-thumb) {
    width: 36px;
    height: 36px;
    border-radius: 3px;
    flex-shrink: 0;
    background: var(--surface-h);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  :global(.detail-thumb img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  :global(.detail-thumb-letter) {
    font-size: 1rem;
    font-weight: 700;
    opacity: 0.35;
  }
  :global(.detail-heading) {
    margin: 0 0 0.12rem;
    font-size: 0.93rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  :global(.detail-links) {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }
  :global(.detail-link) {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.71rem;
    color: inherit;
    opacity: 0.45;
    text-decoration: none;
    border: 1px solid var(--border);
    padding: 0.18rem 0.52rem;
    border-radius: 2px;
    font-family: var(--font-mono);
    transition:
      opacity 0.13s,
      border-color 0.13s;
  }
  :global(.detail-link:hover) {
    opacity: 1;
    border-color: var(--border-h);
  }
  :global(.detail-link.accent) {
    opacity: 0.85;
    color: var(--accent);
    border-color: var(--accent-border);
    background: var(--accent-dim);
    transition:
      opacity 0.15s,
      background 0.15s,
      border-color 0.15s;
  }
  :global(.detail-link.accent:hover) {
    opacity: 1;
    background: color-mix(in srgb, var(--accent) 18%, transparent);
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
  }
  :global(.detail-link svg) {
    width: 12px;
    height: 12px;
    fill: currentColor;
  }
  :global(.detail-desc) {
    margin: 0 0 0.55rem;
    font-size: 0.8rem;
    opacity: 0.6;
    line-height: 1.6;
  }
  :global(.detail-images) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
    gap: 0.35rem;
    margin-bottom: 0.55rem;
  }
  :global(.detail-img-btn) {
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 3px;
    background: none;
    cursor: pointer;
    overflow: hidden;
    aspect-ratio: 16/9;
    display: block;
    transition:
      border-color 0.15s,
      transform 0.15s;
  }
  :global(.detail-img-btn:hover) {
    border-color: var(--border-h);
    transform: scale(1.01);
  }
  :global(.detail-img-btn img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  :global(.detail-tags) {
    display: flex;
    gap: 0.25rem;
    flex-wrap: wrap;
  }
  :global(.detail-tags span),
  :global(.detail-tags .icon-tag) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 20px;
    font-size: 0.62rem;
    font-family: var(--font-mono);
    padding: 0 0.32rem;
    border-radius: 2px;
    background: var(--surface-h);
    color: var(--fg);
    opacity: 0.85;
    border: 1px solid var(--border-h);
  }
  :global(.detail-tags .icon-tag) {
    width: 22px;
    height: 22px;
    padding: 0;
  }
  :global(.detail-tags .icon-tag .icon-mask) {
    width: 12px;
    height: 12px;
    opacity: 0.9;
  }
  :global(.detail-tags span.tool),
  :global(.detail-tags .icon-tag.tool) {
    opacity: 0.5;
  }
  :global(.detail-tags span.type) {
    width: auto;
    padding: 0 0.32rem;
    font-weight: 500;
    text-transform: uppercase;
    background: var(--accent-dim);
    color: var(--accent);
    border-color: var(--accent-border);
    opacity: 1;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 500;
    background: rgba(0, 0, 0, 0.88);
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(4px);
  }
  .lightbox[hidden] {
    display: none !important;
  }
  .lightbox img {
    max-width: min(90vw, 860px);
    max-height: 85vh;
    border-radius: 4px;
    object-fit: contain;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  }
  .lb-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 30px;
    height: 30px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    cursor: pointer;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px;
    transition: background 0.15s;
  }
  .lb-close:hover {
    background: rgba(255, 255, 255, 0.18);
  }
  .lb-close svg {
    width: 100%;
    height: 100%;
  }
</style>
