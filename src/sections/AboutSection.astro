---
import AboutHero from "../components/AboutHero.astro";
import FeaturedRow from "../components/FeaturedRow.astro";
import aboutData from "../lib/data/about-data.json";
import projects from "../lib/data/projects-data.json";
import socials from "../lib/data/socials-data.json";

const { name: ownerName, avatar } = aboutData as any;

const bio = [
  "Hello! I'm Tomás, a developer from Argentina with a background in software development, automation, and data.",
  "I'm currently focused on QA, where I combine a developer's mindset with a strong attention to detail to understand how systems work, where they can fail, and how to make them more reliable.",
];
const featured = (projects as any[]).filter((p: any) => p.featured === true);
---

<section class="about-section" id="section-about">
  <AboutHero
    avatar={avatar ?? "/avatar.jpg"}
    name={ownerName ?? "Tomás Manduca"}
    banner="/banner.jpg"
  />

  <div class="about-body">
    <div class="bio-text">
      {bio.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <p class="socials-line">
      Reach me on
      <a
        href={socials.linkedinUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="social-link"
      >
        <svg class="social-ico" viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="currentColor"
            d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.03-1.85-3.03-1.85 0-2.14 1.45-2.14 2.94v5.66H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.59 0 4.26 2.37 4.26 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"
          ></path>
        </svg>
        LinkedIn
      </a>
      or see my
      <a
        href={socials.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="social-link"
      >
        <svg class="social-ico" viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="currentColor"
            d="M12 .5C5.73.5.5 5.87.5 12.35c0 5.18 3.44 9.58 8.2 11.13.6.12.82-.27.82-.58v-2.17c-3.34.75-4.04-1.65-4.04-1.65-.55-1.42-1.35-1.8-1.35-1.8-1.1-.78.08-.77.08-.77 1.22.09 1.86 1.3 1.86 1.3 1.08 1.9 2.83 1.35 3.52 1.03.11-.81.42-1.35.76-1.66-2.66-.31-5.46-1.37-5.46-6.08 0-1.34.46-2.43 1.22-3.29-.12-.31-.53-1.57.12-3.27 0 0 1-.33 3.3 1.26a11.2 11.2 0 0 1 6 0c2.3-1.6 3.3-1.26 3.3-1.26.65 1.7.24 2.96.12 3.27.76.86 1.22 1.95 1.22 3.29 0 4.72-2.8 5.76-5.47 6.07.43.38.81 1.12.81 2.27v3.36c0 .32.22.7.83.58 4.76-1.55 8.19-5.95 8.19-11.13C23.5 5.87 18.27.5 12 .5z"
          ></path>
        </svg>
        Github
      </a>.
    </p>
  </div>

  <div class="works-preview">
    <a href="/work/" class="panel-label section-label works-link">
      <svg
        class="folder-ico"
        viewBox="0 0 16 16"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M1.5 4.2c0-.66.54-1.2 1.2-1.2h3.4l1.3 1.5h6.9c.66 0 1.2.54 1.2 1.2v7.1c0 .66-.54 1.2-1.2 1.2H2.7c-.66 0-1.2-.54-1.2-1.2V4.2Z"
          stroke="currentColor"
          stroke-width="1.1"
          stroke-linejoin="round"></path>
      </svg>
      Selected projects ({featured.length})
    </a>
    <div class="fi-list">
      {
        featured.map((p: any) => (
          <FeaturedRow
            item={p}
            href={`/work/?open=${encodeURIComponent(p.name)}`}
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  .about-section {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 12px;
    padding-bottom: 1rem;
  }

  .about-body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .bio-text {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .socials-line {
    margin: 0.35rem 0 0;
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.22rem;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .social-link:hover {
    opacity: 0.75;
  }
  .social-ico {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
  }

  .works-preview {
    padding: 0;
  }

  .panel-label {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.65rem;
    font-family: var(--font-mono);
    opacity: 0.5;
    margin: 0 0 0.5rem;
  }
  .section-label {
    font-size: 0.9rem;
    opacity: 0.55;
    font-weight: 500;
  }
  .works-link {
    color: inherit;
    text-decoration: none;
    width: fit-content;
    transition: opacity 0.15s;
  }
  .works-link:hover {
    opacity: 0.85;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .folder-ico {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
  }

  .fi-list {
    display: flex;
    flex-direction: column;
  }
</style>
